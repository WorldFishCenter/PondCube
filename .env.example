# ---- Neon connection string (use the POOLED string from the Neon dashboard) ----
# Local dev: point this at your `dev` branch.
# On Vercel: set DATABASE_URL per environment -> Production = `main` branch, Preview/Dev = `dev` branch.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Production (`main` branch). Only scripts use it, and only with --prod (e.g. `npm run db:sync -- --prod`).
DATABASE_URL_PROD="postgresql://USER:PASSWORD@ep-yyyyy-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ---- Clerk (one account per Operator; app "PondCube") ----
# `npx clerk@latest env pull` fills these. Production uses the Clerk production instance's keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- Airtable (only for `npm run db:sync`, never read by the app) ----
# Personal access token with data.records:read on the PondCube base.
AIRTABLE_API_KEY="pat..."
